# Quick Share 設定範例：複製成 .env 後修改。.env 不要 commit 進 git。

# 必填。用來簽署 session cookie，請自行產生一組隨機值：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 單檔上傳上限（MB）。經 Cloudflare 對外時最多 100。
MAX_UPLOAD_MB=100

# 每個房間保留的檔案數，超過時自動刪除最舊的
MAX_FILES_PER_ROOM=10

# 房間多少天沒有新上傳就整個刪除
ROOM_TTL_DAYS=30

# 擁有者 cookie 有效天數（每次造訪續期）
OWNER_SESSION_DAYS=30

# 顯示檔名時前後各保留的字數，中間以 ... 省略
DISPLAY_NAME_LIMIT=12

# 上傳檔案與 log 的位置；相對路徑以專案根目錄為基準
UPLOAD_DIR=uploads
LOG_FILE=logs/quickshare.log

# waitress 參數。前面有 Cloudflare 時 HOST 請維持 127.0.0.1
HOST=127.0.0.1
PORT=5000
THREADS=4

# 正式環境（經 https 對外）建議設為 true；本機用 http 測試時需為 false
SESSION_COOKIE_SECURE=false
